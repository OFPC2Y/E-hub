<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 本机到 api.nuget.org 会被重定向到 nuget.azure.cn，显式声明镜像源避免还原时协商失败 -->
  <packageSources>
    <clear />
    <add key="nuget.azure.cn" value="https://nuget.azure.cn/v3/index.json" protocolVersion="3" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
