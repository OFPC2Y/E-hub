<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="clr-namespace:EHub.Themes">

    <!-- ══ 菜单 ══════════════════════════════════════════════
         默认的 MenuItem 弹出层用的是系统浅色画刷，不受 Background 影响，
         必须整套换掉模板才能和深色面板一致。 -->

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{x:Static themes:Palette.Card}" />
        <Setter Property="Foreground" Value="{x:Static themes:Palette.Text}" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{x:Static themes:Palette.Card}" />
        <Setter Property="Foreground" Value="{x:Static themes:Palette.Text}" />
        <Setter Property="BorderBrush" Value="{x:Static themes:Palette.Muted}" />
        <Setter Property="Padding" Value="4" />
        <!--
            必须整套换掉模板：默认模板在左侧画了一条图标留白栏，
            用的是硬编码的 #F1F1F1 / #E2E3E3 / #FFFFFF 三个 Rectangle，
            只设 Background 盖不住它，菜单左边会留一条白竖条把条目整体挤右。
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{x:Static themes:Palette.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="12,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <Path x:Name="Arrow"
                                      Grid.Column="1"
                                      Data="M 0 0 L 4 4 L 0 8 Z"
                                      Fill="{x:Static themes:Palette.Subtext}"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <Popup x:Name="SubmenuPopup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                               Placement="Bottom"
                               PopupAnimation="None">
                            <Border Background="{x:Static themes:Palette.Card}"
                                    BorderBrush="{x:Static themes:Palette.Muted}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4"
                                    Margin="0,0,10,10">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SubmenuPopup" Property="Placement" Value="Right" />
                        </Trigger>

                        <!-- 分隔符不需要专门处理：WPF 会把 Separator 控件包进一个
                             MenuItem 容器的 Header 里，由上面那个 ContentPresenter 画出来。
                             注意 MenuItemRole 只有 TopLevel*/Submenu* 四个值，没有 Separator，
                             在这里写 Role=Separator 的触发器会在运行时抛 XamlParseException。 -->

                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{x:Static themes:Palette.Muted}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{x:Static themes:Palette.Subtext}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 菜单里的分隔线。默认样式取的是系统浅灰画刷，深色面板上会过于突兀 -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{x:Static themes:Palette.Muted}" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ 卡片与数据行 ══════════════════════════════════════ -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{x:Static themes:Palette.Card}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="3" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="CardRule" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,3,0,6" />
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{x:Static themes:Palette.Subtext}" />
        <Setter Property="Width" Value="76" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1" />
    </Style>

    <Style x:Key="RowValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{x:Static themes:Palette.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{x:Static themes:Palette.Accent}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="3,2,3,8" />
    </Style>

    <!-- ══ 按钮 ══════════════════════════════════════════════ -->

    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{x:Static themes:Palette.Text}" />
        <Setter Property="Background" Value="{x:Static themes:Palette.Muted}" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 未指定样式的按钮一律走扁平次级外观 -->
    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}" />

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Foreground" Value="{x:Static themes:Palette.Background}" />
        <Setter Property="Background" Value="{x:Static themes:Palette.Accent}" />
    </Style>

    <!-- ══ 输入控件 ══════════════════════════════════════════ -->

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{x:Static themes:Palette.Field}" />
        <Setter Property="Foreground" Value="{x:Static themes:Palette.Text}" />
        <Setter Property="CaretBrush" Value="{x:Static themes:Palette.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{x:Static themes:Palette.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="15" Height="15"
                                CornerRadius="3"
                                Background="{x:Static themes:Palette.Field}"
                                BorderBrush="{x:Static themes:Palette.Muted}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Check"
                                  Data="M 2 6 L 5 9 L 11 2"
                                  Stroke="{x:Static themes:Palette.Accent}"
                                  StrokeThickness="2"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{x:Static themes:Palette.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ 诊断窗口的标签页与文本区 ══════════════════════════ -->

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{x:Static themes:Palette.Background}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent" Margin="6,6,6,0" />
                        <Border Grid.Row="1" Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{x:Static themes:Palette.Subtext}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="4,4,0,0"
                            Padding="14,6"
                            Margin="0,0,2,0">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{x:Static themes:Palette.Card}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{x:Static themes:Palette.Card}" />
                            <Setter Property="Foreground" Value="{x:Static themes:Palette.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RawText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="8" />
    </Style>

</ResourceDictionary>
