<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SystemMonitor</AssemblyName>
    <RootNamespace>EHub</RootNamespace>

    <!-- 传感器读取必须提权；清单里带 requireAdministrator 才会在启动时弹 UAC -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <AssemblyTitle>e-hub 系统监控面板</AssemblyTitle>
    <Product>e-hub</Product>
    <Version>0.9.6</Version>

    <!-- 只保留中英资源，避免每个 NuGet 包都带一堆语言卫星程序集 -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- 版本跟着 LibreHardwareMonitorLib 0.9.6 的依赖走，低于它会被判为包降级 -->
    <PackageReference Include="System.IO.Ports" Version="10.0.3" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- PawnIO 安装向导要跟 exe 一起发出去 -->
    <Content Include="..\..\external\PawnIO_setup.exe"
             Link="external\PawnIO_setup.exe"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- 首次运行的默认配置；用户改过之后保留用户的值 -->
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
