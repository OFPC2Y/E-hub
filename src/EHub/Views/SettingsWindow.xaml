<Window x:Class="EHub.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:EHub.Themes"
        Title="设置"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{x:Static themes:Palette.Background}"
        Foreground="{x:Static themes:Palette.Text}">

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="e-hub 设置"
                   Foreground="{x:Static themes:Palette.Accent}"
                   FontSize="15"
                   FontWeight="Bold"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ping 目标"
                           Style="{StaticResource RowLabel}" Margin="0,0,10,0" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="PingTargetBox" Margin="0,3" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="串口端口"
                           Style="{StaticResource RowLabel}" Margin="0,0,10,0" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SerialPortBox" Margin="0,3" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="波特率"
                           Style="{StaticResource RowLabel}" Margin="0,0,10,0" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="BaudRateBox" Margin="0,3" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="必须与 HUB 固件一致；低于 19200 会发不完整帧"
                           Foreground="{x:Static themes:Palette.Subtext}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="采集间隔(秒)"
                           Style="{StaticResource RowLabel}" Margin="0,0,10,0" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="IntervalBox" Margin="0,3" />
                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="IntervalHint"
                           Foreground="{x:Static themes:Palette.Subtext}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="开机自启监控"
                           Style="{StaticResource RowLabel}" Margin="0,0,10,0" />
                <CheckBox Grid.Row="4" Grid.Column="1" x:Name="AutoStartBox" Margin="0,6" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" x:Name="ConfigPathText"
                   Foreground="{x:Static themes:Palette.Subtext}"
                   FontSize="11"
                   Margin="2,10,0,0" />

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Button Content="恢复默认" HorizontalAlignment="Left" Click="OnResetDefaults" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="OnCancel" Margin="0,0,8,0" />
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="OnSave" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
